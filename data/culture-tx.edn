#:culture{:id "sgp.dish.chilli-crab", :name "Chilli crab", :country "SGP", :kind :dish, :summary "Mud crab stir-fried in a semi-thick, sweet and savoury tomato-and-chilli sauce; created in Singapore in 1956 by Cher Yam Tian, whose family opened Palm Beach Seafood restaurant, and popular in both Singapore and Malaysia.", :url "https://en.wikipedia.org/wiki/Chilli_crab", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "sgp.dish.hainanese-chicken-rice", :name "Hainanese chicken rice", :country "SGP", :kind :dish, :summary "Poached or roasted chicken with seasoned rice and chilli sauce; widely considered one of the national dishes of Singapore, popularised there in the 1940s-50s by Hainanese immigrants, and eaten daily across the country's hawker centres.", :url "https://en.wikipedia.org/wiki/Hainanese_chicken_rice", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "sgp.dish.laksa", :name "Laksa", :country "SGP", :kind :dish, :summary "Spicy coconut-curry or tamarind-soured noodle soup popular across Southeast Asia; the Singaporean-style version and Katong laksa (spoon-only, from a Singapore neighbourhood) are recognized variants, believed to have arisen from Peranakan Chinese interaction with local Singaporean Malays, though the dish is also common in Malaysia and Indonesia.", :url "https://en.wikipedia.org/wiki/Laksa", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "sgp.beverage.singapore-sling", :name "Singapore Sling", :country "SGP", :kind :beverage, :summary "Gin-based sling cocktail reputed to have been developed between 1899 and 1915 by bartender Ngiam Tong Boon at the Long Bar of Raffles Hotel, Singapore, originally colored to resemble fruit juice so women could drink it in public.", :url "https://en.wikipedia.org/wiki/Singapore_sling", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "sgp.festival.chingay-parade", :name "Chingay Parade", :country "SGP", :kind :festival, :summary "Annual street parade held as part of Chinese New Year festivities; Singapore's first Chingay parade took place on 4 February 1973 after Prime Minister Lee Kuan Yew authorized it following a fireworks ban, and it has since grown into a multi-ethnic celebration.", :url "https://en.wikipedia.org/wiki/Chingay_parade", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "sgp.heritage.botanic-gardens", :name "Singapore Botanic Gardens", :country "SGP", :kind :heritage, :summary "Tropical garden founded in 1859, inscribed as a UNESCO World Heritage Site on 4 July 2015 -- Singapore's first such site and the first tropical botanic garden, and only third botanic garden overall, on the World Heritage list.", :url "https://en.wikipedia.org/wiki/Singapore_Botanic_Gardens", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "sgp.heritage.hawker-culture", :name "Hawker culture in Singapore", :country "SGP", :kind :heritage, :summary "Community dining and culinary practices centred on hawker centres, which function as 'community dining rooms' bridging Singapore's multicultural communities; inscribed on the UNESCO Representative List of the Intangible Cultural Heritage of Humanity on 16 December 2020.", :url "https://en.wikipedia.org/wiki/Hawker_centre", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
]
